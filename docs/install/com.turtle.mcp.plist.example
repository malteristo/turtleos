<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.turtle.mcp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/turtle/turtleos/venv/bin/python3</string>
        <string>/Users/turtle/turtleos/mcp_server.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>3141</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/turtle/turtleos</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TURTLE_MCP_STATE</key>
        <string>/Users/turtle/.turtleos/mcp</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/turtle/turtleos/logs/mcp.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/turtle/turtleos/logs/mcp.log</string>
</dict>
</plist>
